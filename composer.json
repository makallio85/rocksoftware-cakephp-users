{
    "name": "makallio85/rocksoftware-cakephp-users",
    "description": "CakePHP 5 plugin for everything about signing in to a Rock Software application: Rock Software ID (OpenID Connect), password sign-in, sessions, sign-in history, the users page and the user menu.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "sso", "oidc", "openid-connect", "authentik"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Marko Kallio",
            "email": "marko@rocksoftware.fi"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/authentication": "^3.2",
        "cakephp/cakephp": "^5.1",
        "cakephp/migrations": "^4.0 || ^5.0",
        "firebase/php-jwt": "^6.10 || ^7.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "RockSoftware\\Users\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RockSoftware\\Users\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --colors -p src/ tests/",
        "cs-fix": "phpcbf --colors -p src/ tests/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    }
}
